together_again <- left_join(together, fed, by c("public_id"="public_id", "trip_year"="trip_year"))
together_again <- left_join(together, fed, by = c("public_id"="public_id", "trip_year"="trip_year"))
together_again <- left_join(together, fed, by = c("public_id"="public_id", "trip_year"="year"))
