##Pull list of active 2021 permit holders from NYFISH and join to list of SAFIS active permits. This connects the SAFIS participant_id to public_id, so we can match
##public_id to active SAFIS accounts.
ch <- odbcConnect("CMFS_prod")
qry4 <- "SELECT INFO_PERMIT.whole_name, INFO_PERMIT.public_id, INFO_PERMIT.year, INFO_PERMIT.federal"
qry5 <-  "FROM INFO_PERMIT"
qry6 <-  "WHERE (((INFO_PERMIT.year)='2019' Or (INFO_PERMIT.year)='2020') AND ((INFO_PERMIT.federal)=Yes));"
fedqry <- paste(qry4, qry5, qry6)
nyfish_fed <- sqlQuery(ch, fedqry)
NYFISHraw <- sqlQuery(ch, qry)
nyfish_fed <- sqlQuery(ch, fedqry)
fedqry
qry4 <- "SELECT INFO_PERMIT.whole_name, INFO_PERMIT.public_id, INFO_PERMIT.year, INFO_PERMIT.federal"
qry5 <-  "FROM INFO_PERMIT"
qry6 <-  "WHERE (((INFO_PERMIT.year)='2019' Or (INFO_PERMIT.year)='2020') AND ((INFO_PERMIT.federal)=Yes))"
fedqry <- paste(qry4, qry5, qry6)
nyfish_fed <- sqlQuery(ch, fedqry)
qry6 <-  "WHERE (((INFO_PERMIT.year)='2019' Or (INFO_PERMIT.year)='2020') AND (INFO_PERMIT.federal)=Yes)"
fedqry <- paste(qry4, qry5, qry6)
nyfish_fed <- sqlQuery(ch, fedqry)
fedqry <- "SELECT INFO_PERMIT.whole_name, INFO_PERMIT.public_id, INFO_PERMIT.year, INFO_PERMIT.federal FROM INFO_PERMIT WHERE (((INFO_PERMIT.year)='2019' Or (INFO_PERMIT.year)='2020') AND ((INFO_PERMIT.federal)=Yes))"
nyfish_fed <- sqlQuery(ch, fedqry)
fedqry <- "SELECT INFO_PERMIT.whole_name, INFO_PERMIT.public_id, INFO_PERMIT.year, INFO_PERMIT.federal FROM INFO_PERMIT WHERE INFO_PERMIT.year IN ('2019', '2020') AND (INFO_PERMIT.federal=1)"
nyfish_fed <- sqlQuery(ch, fedqry)
library(glue)
fedqry <- glue("SELECT INFO_PERMIT.whole_name, INFO_PERMIT.public_id, INFO_PERMIT.year, INFO_PERMIT.federal FROM INFO_PERMIT WHERE INFO_PERMIT.year IN ({x}) AND (INFO_PERMIT.federal=1)")
x <- "'2019','2020'"
fedqry <- glue("SELECT INFO_PERMIT.whole_name, INFO_PERMIT.public_id, INFO_PERMIT.year, INFO_PERMIT.federal FROM INFO_PERMIT WHERE INFO_PERMIT.year IN ({x}) AND (INFO_PERMIT.federal=1)")
